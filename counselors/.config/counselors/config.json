{
  "version": 1,
  "defaults": {
    "timeout": 1500,
    "outputDir": "./agents/counselors",
    "readOnly": "bestEffort",
    "maxContextKb": 100,
    "maxParallel": 4
  },
  "tools": {
    "claude-opus": {
      "binary": "/home/void/.local/bin/claude",
      "adapter": "claude",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["--model", "opus"]
    },
    "claude-opus-4-6": {
      "binary": "/home/void/.local/bin/claude",
      "adapter": "claude",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["--model", "claude-opus-4-6"]
    },
    "claude-sonnet": {
      "binary": "/home/void/.local/bin/claude",
      "adapter": "claude",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["--model", "sonnet"]
    },
    "codex-5.3-xhigh": {
      "binary": "/usr/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": [
        "-m",
        "gpt-5.3-codex",
        "-c",
        "model_reasoning_effort=xhigh"
      ],
      "timeout": 1500
    },
    "codex-5.3-high": {
      "binary": "/usr/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": [
        "-m",
        "gpt-5.3-codex",
        "-c",
        "model_reasoning_effort=high"
      ],
      "timeout": 1500
    },
    "gpt-5.4-xhigh": {
      "binary": "/usr/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["-m", "gpt-5.4", "-c", "model_reasoning_effort=xhigh"],
      "timeout": 1500
    },
    "gpt-5.4-high": {
      "binary": "/usr/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["-m", "gpt-5.4", "-c", "model_reasoning_effort=high"],
      "timeout": 1500
    },
    "gpt-5.5-xhigh": {
      "binary": "/usr/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["-m", "gpt-5.5", "-c", "model_reasoning_effort=xhigh"],
      "timeout": 1500
    },
    "gpt-5.5-high": {
      "binary": "/usr/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": ["-m", "gpt-5.5", "-c", "model_reasoning_effort=high"],
      "timeout": 1500
    }
  },
  "groups": {
    "default": [
      "claude-opus",
      "codex-5.3-high",
      "gpt-5.4-high",
      "gpt-5.5-high"
    ],
    "codex": ["codex-5.3-high", "gpt-5.4-high", "gpt-5.5-high"],
    "claude": ["claude-opus", "claude-sonnet", "claude-opus-4.6"]
  }
}
