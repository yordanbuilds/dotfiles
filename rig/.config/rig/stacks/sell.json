{
  "root": "~/code/sell",
  "server": {
    "sail": "./vendor/bin/sail up -d",
    "vite": {
      "run": "./vendor/bin/sail npm run build",
      "after": "sail"
    },
    "tunnel": {
      "run": "cloudflared tunnel run sell-dev",
      "after": "vite"
    }
  },
  "workers": {
    "queues": {
      "run": "./vendor/bin/sail artisan queue:listen",
      "after": "sail"
    },
    "scheduler": {
      "run": "./vendor/bin/sail artisan schedule:work",
      "after": "sail"
    }
  },
  "stripe": {
    "listen": {
      "run": "stripe listen --api-key $(grep '^STRIPE_SECRET=' .env | cut -d= -f2) --all-snapshot --forward-to localhost/stripe/webhook-connect",
      "ready": "Ready!"
    }
  },
  "claude": "claude",
  "terminal": null
}
