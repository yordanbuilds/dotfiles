#!/bin/bash

# Omarchy theme-set hook: Sync Qt6 (Fusion) app colors with omarchy theme
# Generates a qt6ct color scheme from current omarchy theme colors,
# so apps like Kdenlive follow the light/dark theme switch.
# Note: Running Qt apps need a restart to pick up changes.

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
QT6CT_COLORS_DIR="$HOME/.config/qt6ct/colors"
QT6CT_CONF="$HOME/.config/qt6ct/qt6ct.conf"
KDENLIVERC="$HOME/.config/kdenliverc"

# --- Color helpers ---

get_color() {
  grep "^$1 " "$THEME_DIR/colors.toml" | sed 's/.*"\(#[^"]*\)".*/\1/'
}

to_qt() { echo "#ff${1#\#}"; }

lighten() {
  local hex="${1#\#}" pct="$2"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  r=$((r + (255 - r) * pct / 100))
  g=$((g + (255 - g) * pct / 100))
  b=$((b + (255 - b) * pct / 100))
  printf "#ff%02x%02x%02x" "$r" "$g" "$b"
}

darken() {
  local hex="${1#\#}" pct="$2"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  r=$((r * (100 - pct) / 100))
  g=$((g * (100 - pct) / 100))
  b=$((b * (100 - pct) / 100))
  printf "#ff%02x%02x%02x" "$r" "$g" "$b"
}

contrast_text() {
  local hex="${1#\#}"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  local lum=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
  if [ "$lum" -gt 128 ]; then echo "#ff000000"; else echo "#ffffffff"; fi
}

# --- Read theme colors ---

bg=$(get_color background)
fg=$(get_color foreground)
accent=$(get_color accent)
color5=$(get_color magenta)

is_light=false
grep -q '^mode *= *"light"' "$THEME_DIR/colors.toml" && is_light=true

qt_bg=$(to_qt "$bg")
qt_fg=$(to_qt "$fg")
qt_accent=$(to_qt "$accent")

# --- Build QPalette ---
# WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText,
# ButtonText, Base, Window, Shadow, Highlight, HighlightedText,
# Link, LinkVisited, AlternateBase, ToolTipBase, ToolTipText,
# PlaceholderText, Accent

if $is_light; then
  qt_button=$(darken "$bg" 5)
  qt_light=$(lighten "$bg" 50)
  qt_midlight=$(lighten "$bg" 25)
  qt_dark=$(darken "$bg" 40)
  qt_mid=$(darken "$bg" 20)
  qt_base=$(lighten "$bg" 40)
  qt_altbase=$(darken "$bg" 3)
  qt_shadow=$(darken "$bg" 70)
  qt_placeholder=$(lighten "$fg" 40)
  dis_fg=$(lighten "$fg" 50)
else
  qt_button=$(lighten "$bg" 10)
  qt_light=$(lighten "$bg" 25)
  qt_midlight=$(lighten "$bg" 15)
  qt_dark=$(darken "$bg" 30)
  qt_mid=$(lighten "$bg" 5)
  qt_base=$(lighten "$bg" 5)
  qt_altbase=$(lighten "$bg" 8)
  qt_shadow=$(darken "$bg" 50)
  qt_placeholder=$(darken "$fg" 40)
  dis_fg=$(darken "$fg" 40)
fi

qt_bright="#ffffffff"
qt_highlight=$(to_qt "$accent")
qt_highlight_text=$(contrast_text "$accent")
qt_link=$(to_qt "$accent")
qt_link_visited=$(to_qt "${color5:-$accent}")
qt_tooltip_base=$(to_qt "$fg")
qt_tooltip_text=$(to_qt "$bg")

active="$qt_fg, $qt_button, $qt_light, $qt_midlight, $qt_dark, $qt_mid, $qt_fg, $qt_bright, $qt_fg, $qt_base, $qt_bg, $qt_shadow, $qt_highlight, $qt_highlight_text, $qt_link, $qt_link_visited, $qt_altbase, $qt_tooltip_base, $qt_tooltip_text, $qt_placeholder, $qt_accent"

disabled="$dis_fg, $qt_button, $qt_light, $qt_midlight, $qt_dark, $qt_mid, $dis_fg, $qt_bright, $dis_fg, $qt_base, $qt_bg, $qt_shadow, $qt_highlight, $qt_highlight_text, $qt_link, $qt_link_visited, $qt_altbase, $qt_tooltip_base, $qt_tooltip_text, $qt_placeholder, $qt_accent"

inactive="$active"

# --- Write qt6ct color scheme ---

mkdir -p "$QT6CT_COLORS_DIR"
cat > "$QT6CT_COLORS_DIR/omarchy.conf" << EOF
[ColorScheme]
active_colors=$active
disabled_colors=$disabled
inactive_colors=$inactive
EOF

# --- Update qt6ct.conf ---

if [ -f "$QT6CT_CONF" ]; then
  sed -i 's/^custom_palette=.*/custom_palette=true/' "$QT6CT_CONF"
  if grep -q '^color_scheme_path=' "$QT6CT_CONF"; then
    sed -i "s|^color_scheme_path=.*|color_scheme_path=$QT6CT_COLORS_DIR/omarchy.conf|" "$QT6CT_CONF"
  else
    sed -i "/^\[Appearance\]/a color_scheme_path=$QT6CT_COLORS_DIR/omarchy.conf" "$QT6CT_CONF"
  fi
fi

# --- Update Kdenlive ---

if [ -f "$KDENLIVERC" ]; then
  # Color scheme (light/dark)
  if $is_light; then
    sed -i 's/^ColorScheme=.*/ColorScheme=BreezeLight/' "$KDENLIVERC"
    sed -i 's/^ColorSchemePath=.*/ColorSchemePath=BreezeLight.colors/' "$KDENLIVERC"
  else
    sed -i 's/^ColorScheme=.*/ColorScheme=BreezeDark/' "$KDENLIVERC"
    sed -i 's/^ColorSchemePath=.*/ColorSchemePath=BreezeDark.colors/' "$KDENLIVERC"
  fi

  # Monitor background: neutral gray that matches the theme's lightness
  local_bg="${bg#\#}"
  bg_r=$((16#${local_bg:0:2})) bg_g=$((16#${local_bg:2:2})) bg_b=$((16#${local_bg:4:2}))
  lum=$(( (bg_r * 299 + bg_g * 587 + bg_b * 114) / 1000 ))
  # Slightly muted from the UI background so the video frame has an edge
  if $is_light; then
    gray=$(( lum * 90 / 100 ))
  else
    gray=$(( lum * 80 / 100 ))
  fi
  sed -i "s/^window_background=.*/window_background=$gray,$gray,$gray/" "$KDENLIVERC"
fi

# --- Sync tuicr theme ---
# Maps omarchy themes to tuicr's bundled equivalents where they exist,
# and generates local tuicr themes from colors.toml for the rest
# (written to ~/.config/tuicr/themes/omarchy-<slug>.toml).
# tuicr reads its config at startup, so new sessions pick up the change.

TUICR_DIR="$HOME/.config/tuicr"
TUICR_THEMES_DIR="$TUICR_DIR/themes"
TUICR_CONFIG="$TUICR_DIR/config.toml"

tuicr_bundled() {
  case "$1" in
    catppuccin) echo "catppuccin-mocha" ;;
    catppuccin-latte) echo "catppuccin-latte" ;;
    everforest) echo "everforest-dark" ;;
    gruvbox) echo "gruvbox-dark" ;;
    nord) echo "nord-dark" ;;
    tokyo-night) echo "tokyo-night-storm" ;;
  esac
}

read_theme_color() {
  grep -m1 "^$2 " "$1/colors.toml" | sed 's/.*"\(#[^"]*\)".*/\1/'
}

# Mix $1 toward $2, keeping $3% of $1
mix_colors() {
  local a="${1#\#}" b="${2#\#}" p="$3"
  a="${a,,}" b="${b,,}"
  printf "#%02x%02x%02x" \
    $(((16#${a:0:2} * p + 16#${b:0:2} * (100 - p)) / 100)) \
    $(((16#${a:2:2} * p + 16#${b:2:2} * (100 - p)) / 100)) \
    $(((16#${a:4:2} * p + 16#${b:4:2} * (100 - p)) / 100))
}

# $1 = omarchy theme dir, $2 = output file
tuicr_generate() {
  local dir="$1" out="$2"
  local bg fg accent cursor c1 c2 c3 c4 c5 c6

  bg=$(read_theme_color "$dir" background)
  fg=$(read_theme_color "$dir" foreground)
  accent=$(read_theme_color "$dir" accent)
  cursor=$(read_theme_color "$dir" cursor)
  c1=$(read_theme_color "$dir" red)
  c2=$(read_theme_color "$dir" green)
  c3=$(read_theme_color "$dir" yellow)
  c4=$(read_theme_color "$dir" blue)
  c5=$(read_theme_color "$dir" magenta)
  c6=$(read_theme_color "$dir" cyan)

  [ -n "$bg" ] && [ -n "$fg" ] || return 1
  accent="${accent:-$c4}"
  cursor="${cursor:-$fg}"

  cat >"$out" <<EOF
# Generated from omarchy theme '$(basename "$dir")' by the theme-set hook - do not edit

panel_bg = "$bg"
bg_highlight = "$(mix_colors "$fg" "$bg" 12)"
fg_primary = "$fg"
fg_secondary = "$(mix_colors "$fg" "$bg" 70)"
fg_dim = "$(mix_colors "$fg" "$bg" 45)"
diff_add = "$c2"
diff_add_bg = "$(mix_colors "$c2" "$bg" 18)"
diff_del = "$c1"
diff_del_bg = "$(mix_colors "$c1" "$bg" 18)"
diff_context = "$fg"
diff_hunk_header = "$c4"
expanded_context_fg = "$(mix_colors "$fg" "$bg" 45)"
syntax_add_bg = "$(mix_colors "$c2" "$bg" 18)"
syntax_del_bg = "$(mix_colors "$c1" "$bg" 18)"
file_added = "$c2"
file_modified = "$c3"
file_deleted = "$c1"
file_renamed = "$c5"
reviewed = "$c2"
pending = "$c3"
comment_note = "$c4"
comment_suggestion = "$c6"
comment_issue = "$c1"
comment_praise = "$c2"
border_focused = "$accent"
border_unfocused = "$(mix_colors "$fg" "$bg" 25)"
status_bar_bg = "$(mix_colors "$fg" "$bg" 8)"
cursor_color = "$cursor"
cursor_line_bg = "$(mix_colors "$fg" "$bg" 10)"
branch_name = "$c5"
help_indicator = "$(mix_colors "$fg" "$bg" 45)"
message_info_fg = "$bg"
message_info_bg = "$c4"
message_warning_fg = "$bg"
message_warning_bg = "$c3"
message_error_fg = "$bg"
message_error_bg = "$c1"
update_badge_fg = "$bg"
update_badge_bg = "$c3"
mode_fg = "$bg"
mode_bg = "$accent"
EOF
}

mkdir -p "$TUICR_THEMES_DIR"

# Regenerate local themes for every installed omarchy theme without a bundled match,
# so they stay available for manual `tuicr --theme` use
for dir in /usr/share/omarchy/themes/*/ "$HOME/.config/omarchy/themes"/*/; do
  [ -f "$dir/colors.toml" ] || continue
  slug=$(basename "$dir")
  [ -n "$(tuicr_bundled "$slug")" ] && continue
  tuicr_generate "$dir" "$TUICR_THEMES_DIR/omarchy-$slug.toml"
done

# Point tuicr at the theme just set
tuicr_theme=$(tuicr_bundled "$1")
if [ -z "$tuicr_theme" ]; then
  tuicr_theme="omarchy-$1"
  # Current dir includes user overlays, so regenerate the active theme from it
  tuicr_generate "$THEME_DIR" "$TUICR_THEMES_DIR/$tuicr_theme.toml"
fi

if [ -s "$TUICR_CONFIG" ]; then
  if grep -q '^theme *= ' "$TUICR_CONFIG"; then
    sed -i "s/^theme *= .*/theme = \"$tuicr_theme\"/" "$TUICR_CONFIG"
  else
    sed -i "1i theme = \"$tuicr_theme\"" "$TUICR_CONFIG"
  fi
else
  echo "theme = \"$tuicr_theme\"" >"$TUICR_CONFIG"
fi

# --- Sync herdr theme ---
# Maps omarchy themes to herdr's built-in equivalents where they exist;
# otherwise generates a [theme.custom] token-override block from colors.toml.
# Herdr has no separate theme files, so the hook owns a marked block at the
# end of config.toml. Written via cat > to preserve the stow symlink.

HERDR_CONFIG="$HOME/.config/herdr/config.toml"
HERDR_BLOCK_START="# >>> omarchy theme sync - do not edit >>>"
HERDR_BLOCK_END="# <<< omarchy theme sync - do not edit <<<"

herdr_builtin() {
  case "$1" in
    catppuccin) echo "catppuccin" ;;
    catppuccin-latte) echo "catppuccin-latte" ;;
    gruvbox) echo "gruvbox" ;;
    kanagawa) echo "kanagawa" ;;
    nord) echo "nord" ;;
    rose-pine) echo "rose-pine-dawn" ;;
    tokyo-night) echo "tokyo-night" ;;
  esac
}

# $1 = omarchy theme dir; emits a full [theme] block with custom token overrides
herdr_custom_block() {
  local dir="$1"
  local bg fg accent c1 c2 c3 c4 c5 c6 base

  bg=$(read_theme_color "$dir" background)
  fg=$(read_theme_color "$dir" foreground)
  accent=$(read_theme_color "$dir" accent)
  c1=$(read_theme_color "$dir" red)
  c2=$(read_theme_color "$dir" green)
  c3=$(read_theme_color "$dir" yellow)
  c4=$(read_theme_color "$dir" blue)
  c5=$(read_theme_color "$dir" magenta)
  c6=$(read_theme_color "$dir" cyan)

  [ -n "$bg" ] && [ -n "$fg" ] || return 1
  accent="${accent:-$c4}"

  base="catppuccin"
  grep -q '^mode *= *"light"' "$dir/colors.toml" && base="catppuccin-latte"

  cat <<EOF
[theme]
name = "$base"
auto_switch = false

[theme.custom]
accent = "$accent"
panel_bg = "$(mix_colors "#000000" "$bg" 12)"
surface_dim = "$(mix_colors "$fg" "$bg" 6)"
surface0 = "$(mix_colors "$fg" "$bg" 10)"
surface1 = "$(mix_colors "$fg" "$bg" 16)"
overlay0 = "$(mix_colors "$fg" "$bg" 30)"
overlay1 = "$(mix_colors "$fg" "$bg" 40)"
text = "$fg"
subtext0 = "$(mix_colors "$fg" "$bg" 65)"
red = "$c1"
green = "$c2"
yellow = "$c3"
blue = "$c4"
mauve = "$c5"
teal = "$c6"
peach = "$(mix_colors "$c1" "$c3" 50)"
EOF
}

if [ -f "$HERDR_CONFIG" ]; then
  herdr_name=$(herdr_builtin "$1")
  if [ -n "$herdr_name" ]; then
    herdr_block=$(printf '[theme]\nname = "%s"\nauto_switch = false\n' "$herdr_name")
  else
    herdr_block=$(herdr_custom_block "$THEME_DIR")
  fi

  if [ -n "$herdr_block" ]; then
    # Drop the previous managed block, then append the new one at the end
    # ($(...) strips trailing blank lines, so this stays idempotent)
    herdr_rest=$(awk -v s="$HERDR_BLOCK_START" -v e="$HERDR_BLOCK_END" \
      '$0 == s {skip = 1; next} $0 == e {skip = 0; next} !skip' "$HERDR_CONFIG")
    printf '%s\n\n%s\n%s\n%s\n' \
      "$herdr_rest" "$HERDR_BLOCK_START" "$herdr_block" "$HERDR_BLOCK_END" >"$HERDR_CONFIG"

    # Recolor a running herdr server live (no-op when none is running)
    herdr server reload-config >/dev/null 2>&1
  fi
fi

# >>> omazed hook - do not edit >>>
omazed set "$1"
# <<< omazed hook - do not edit <<<
