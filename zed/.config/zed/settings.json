// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "debugger": {
    "button": false,
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "git_panel": {
    "dock": "left",
  },
  "word_diff_enabled": true,
  "cursor_shape": "block",
  "cursor_blink": false,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "project_panel": {
    "button": false,
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "outline_panel": {
    "button": false,
    "dock": "right",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": "Omazed",
  "format_on_save": "on",
}
